#: code:addons/cadiffusion_base/models/ca_diffusion_preparer.py:0
msgid ""
"\"%(name)s\" cannot be %(action)s: still used by %(usage)s. Archive it to "
"stop offering it, or reassign the affected records first."
msgstr ""
"« %(name)s » ne peut pas être %(action)s : encore utilisé par %(usage)s. "
"Archivez-le pour ne plus le proposer, ou réaffectez d'abord les "
"enregistrements concernés."

#. module: cadiffusion_base
#: code:addons/cadiffusion_base/models/ca_diffusion_preparer.py:0
msgid ""
"\"%(value)s\" is not part of the preparer list (%(field)s). Add it first in "
"Inventory → Configuration → Preparers."
msgstr ""
"« %(value)s » ne fait pas partie de la liste des préparateurs (%(field)s). "
"Ajoutez-le d'abord dans Inventaire → Configuration → Préparateurs."

