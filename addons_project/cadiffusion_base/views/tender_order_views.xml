<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- tender.order form view -->
    <record id="view_tender_order_form_studio" model="ir.ui.view">
        <field name="name">tender.order.form.studio</field>
        <field name="model">tender.order</field>
        <field name="inherit_id" ref="public_tender.view_tender_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reset']" position="attributes">
                <attribute name="groups">base.group_system</attribute>
                <attribute name="invisible">state == 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='end_date']" position="after">
                <field name="x_studio_dbut_de_march" string="Début de Marché"/>
            </xpath>
            <xpath expr="//field[@name='end_of_the_tender']" position="after">
                <field name="x_studio_coordinateur" string="Coordinateur"/>
                <field name="x_studio_contact" string="Contact"/>
                <field name="x_studio_tlphone" string="Téléphone"/>
                <field name="x_studio_email" string="Email"/>
            </xpath>
            <xpath expr="//field[@name='note']" position="after">
                <field name="x_studio_notes_march" string="Notes Marché"/>
            </xpath>
        </field>
    </record>

    <!-- tender.order list view -->
    <record id="view_tender_order_list_studio" model="ir.ui.view">
        <field name="name">tender.order.list.studio</field>
        <field name="model">tender.order</field>
        <field name="inherit_id" ref="public_tender.tender_order_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list[1]/field[@name='name']" position="after">
                <field name="x_studio_coordinateur" readonly="1"/>
                <field name="x_studio_dbut_de_march"/>
                <field name="end_of_the_tender"/>
                <field name="last_revision_date" widget="date"/>
                <field name="next_revision_date" widget="date"/>
            </xpath>
            <xpath expr="//field[@name='tender_pricelist_id']" position="attributes">
                <attribute name="readonly">state == 'confirm'</attribute>
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- tender.order search view -->
    <record id="view_tender_order_search_studio" model="ir.ui.view">
        <field name="name">tender.order.search.studio</field>
        <field name="model">tender.order</field>
        <field name="inherit_id" ref="public_tender.view_tender_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tender_price_lines']" position="after">
                <field name="partner_ids"/>
                <field name="tender_pricelist_id"/>
            </xpath>
            <xpath expr="//filter[@name='confirm']" position="after">
                <filter domain="[['active','=',False]]" name="studio_filter_archived" string="Archivé"/>
                <filter name="studio_filter_end_date" string="End Date" date="end_date"/>
                <filter name="studio_filter_end_of_tender" string="End Of The Tender" date="end_of_the_tender"/>
                <group name="studio_group_by">
                    <filter context="{'group_by': 'state'}" name="studio_group_by_state" string="State"/>
                    <filter context="{'group_by': 'write_date'}" name="studio_group_by_write_date" string="Last Updated on"/>
                    <filter context="{'group_by': 'write_uid'}" name="studio_group_by_write_uid" string="Last Updated by"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
