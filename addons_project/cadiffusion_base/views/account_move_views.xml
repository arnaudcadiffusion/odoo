<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- account.account list view -->
    <record id="view_account_account_list_studio" model="ir.ui.view">
        <field name="name">account.account.list.studio</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list[1]/field[@name='name']" position="after">
                <field name="x_studio_code_taxe" string="Code taxe"/>
            </xpath>
        </field>
    </record>

    <!-- account.move form view -->
    <record id="view_account_move_form_studio" model="ir.ui.view">
        <field name="name">account.move.form.studio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Code Service Chorus after fiscal_position_id (payment_mode_id no longer exists in Odoo 19) -->
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="x_studio_code_service_chorus" readonly="1" string="Code Service Chorus"/>
            </xpath>
            <!-- discount: remove groups restriction -->
            <xpath expr="//field[@name='discount']" position="attributes">
                <attribute name="groups"/>
            </xpath>
            <!-- product_uom_id: optional hide + readonly (comme en vente :
                 l'unité est portée par le produit, pas modifiable à la main) -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <!-- Colis / Nb Carton (affichage v15, lecture seule) avant la
                 quantité, comme sur la commande de vente -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="carton_uom_id" string="Colis" optional="show"/>
                <field name="nb_carton" string="Nb Carton" optional="show"/>
            </xpath>
            <!-- journal_div: show conditionally -->
            <div name="journal_div" position="replace">
                <div name="journal_div" class="d-flex" invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'">
                    <field name="journal_id" groups="account.group_account_readonly" options="{'no_create': True}" readonly="posted_before == True"/>
                </div>
            </div>
            <!-- Move payment_reference after qr_code_method -->
            <xpath expr="//field[@name='qr_code_method']" position="after">
                <xpath expr="//field[@name='payment_reference']" position="move"/>
                <field name="currency_id" groups="base.group_multi_currency" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- account.move list view (invoice list) -->
    <record id="view_account_invoice_list_studio" model="ir.ui.view">
        <field name="name">account.invoice.list.studio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- transmit_method_id after invoice_user_id (payment_mode_id removed in Odoo 19) -->
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="transmit_method_id" optional="show"/>
            </xpath>
            <!-- Hide salesperson column -->
            <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Hide tax-excluded amount (already optional="show" in base, set column_invisible) -->
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Hide tax amount -->
            <xpath expr="//field[@name='amount_tax_signed']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Add chorus_status after status_in_payment (state field removed in Odoo 19 list view) -->
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="chorus_status" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- account.move list view (move list) -->
    <record id="view_account_move_list_studio" model="ir.ui.view">
        <field name="name">account.move.list.studio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <!-- Add Montant HT before amount_total_signed (amount_tax no longer in this view) -->
            <xpath expr="//field[@name='amount_total_signed']" position="before">
                <field name="amount_untaxed_signed" string="Montant HT" sum="Total"/>
            </xpath>
        </field>
    </record>

    <!-- account.move out invoice list view (1) - amount_untaxed label -->
    <record id="view_account_out_invoice_list_studio_1" model="ir.ui.view">
        <field name="name">account.out.invoice.list.studio.1</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <!-- Rename tax-excluded column to "Total HT" -->
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="string">Total HT</attribute>
            </xpath>
        </field>
    </record>

    <!-- account.move out invoice list view (2) - date widget + is_move_sent -->
    <record id="view_account_out_invoice_list_studio_2" model="ir.ui.view">
        <field name="name">account.out.invoice.list.studio.2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <!-- Add is_move_sent after status_in_payment (payment_state not an explicit field in Odoo 19 list) -->
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="is_move_sent" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- account.move.line list view (1) - with CMUP and date -->
    <record id="view_account_move_line_list_studio_1" model="ir.ui.view">
        <field name="name">account.move.line.list.studio.1</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- Add x_studio_date before name -->
            <xpath expr="//list[1]/field[@name='name']" position="before">
                <field name="x_studio_date" string="Date"/>
            </xpath>
            <!-- Add x_studio_cmup after product_id (quantity not in this view) -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="x_studio_cmup" string="CMUP" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- account.move.line list view (2) - with tax_ids -->
    <record id="view_account_move_line_list_studio_2" model="ir.ui.view">
        <field name="name">account.move.line.list.studio.2</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- amount_currency: optional show (visible by default for multicurrency) -->
            <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="sum">Sum of Amount in Currency</attribute>
            </xpath>
        </field>
    </record>

</odoo>
