<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- purchase.order form view -->
    <record id="view_purchase_order_form_studio" model="ir.ui.view">
        <field name="name">purchase.order.form.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="ca_diff_n_fournisseur" string="N# Fournisseur" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Fournisseur</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='currency_id']" position="after">
                <field name="ca_diff_pod_1" string="POL"/>
                <field name="ca_diff_type" string="Type"/>
                <field name="ca_diff_taux_eur_usd" string="Taux €/$"/>
                <field name="ca_diff_fret" string="Fret"/>
                <field name="ca_diff_transport_achat" string="Douane"/>
                <field name="ca_diff_transport_po" string="Transport PO"/>
                <field name="ca_diff_transitaire" string="Transitaire"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="create_date" string="Date Creation" widget="date"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/div[@name='date_approve']/field[@name='date_approve']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/div[@name='date_planned_div']/field[@name='date_planned']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//div[@name='reminder']" position="after">
                <field name="ca_diff_date_prvue_initiale" string="Dispo initiale"/>
                <field name="ca_diff_dispo_confirmee" string="Dispo confirmée"/>
                <field name="ca_diff_date_depart" string="ETD"/>
                <xpath expr="//field[@name='effective_date']" position="move"/>
                <field name="ca_diff_embarquement" string="Embarquement"/>
            </xpath>
            <!-- Order line: add x_studio fields after name (optional, hidden by default) -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='name']" position="after">
                <field name="ca_diff_ref_fournisseur" string="Ref Fournisseur" optional="hide"/>
                <field name="ca_diff_date_initiale" string="Date Initiale" optional="hide"/>
            </xpath>
            <!-- date_planned: date widget -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='date_planned']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <!-- Conditionnement / Nb Carton puis product_qty et product_uom_id après
                 qty_received_method → ordre : conditionnement → nb carton → qté → udm.
                 Conditionnement / Nb Carton sont les équivalents v19 de
                 product_packaging_id / product_packaging_qty (supprimés en 19) : le
                 conditionnement est choisi parmi les UDM du produit (pré-rempli avec
                 le plus grand carton), saisir Nb Carton met à jour la quantité. -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='qty_received_method']" position="after">
                <field name="allowed_uom_ids" column_invisible="1"/>
                <field name="carton_uom_id" string="Conditionnement" optional="show"
                       domain="[('id', 'in', allowed_uom_ids)]"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="is_downpayment"/>
                <field name="nb_carton" string="Nb Carton" optional="show"
                       readonly="is_downpayment"/>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_qty']" position="move"/>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_uom_id']" position="move"/>
            </xpath>
            <!-- product_uom_id: optional, visible par défaut, lecture seule
                 (comme côté vente : la ligne reste en pièces, la quantité se
                 pilote via Conditionnement / Nb Carton) -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="readonly">1</attribute>
                <attribute name="required">display_type == False</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.order list view (orders) -->
    <record id="view_purchase_order_list_studio" model="ir.ui.view">
        <field name="name">purchase.order.list.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="partner_ref"/>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="replace"/>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="ca_diff_etat_facture" string="Etat Facture"/>
            </xpath>
        </field>
    </record>

    <!-- purchase.order list view (KPIs) -->
    <record id="view_purchase_order_kpis_list_studio" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.order list view (purchase_order_view_tree) -->
    <record id="view_purchase_order_view_tree_studio" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <!-- Masque date_planned à sa position originale (fin de liste) -->
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <!-- Réinsère date_planned juste après Société (company_id) -->
            <xpath expr="//field[@name='company_id'][@groups='!base.group_multi_company']" position="after">
                <field name="date_planned" column_invisible="context.get('quotation_only', False)" optional="show" widget="date"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="ca_diff_type" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- purchase.order calendar view -->
    <record id="view_purchase_order_calendar_studio" model="ir.ui.view">
        <field name="name">purchase.order.calendar.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_calendar"/>
        <field name="arch" type="xml">
            <!-- quick_add removed in Odoo 19 -->
            <xpath expr="//calendar[1]" position="attributes">
                <attribute name="date_start">ca_diff_date_prvue_initiale</attribute>
            </xpath>
        </field>
    </record>

    <!-- purchase.order search view -->
    <record id="view_purchase_order_search_studio" model="ir.ui.view">
        <field name="name">purchase.order.search.studio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/group[1]/filter[@name='order_date']" position="after">
                <filter name="studio_group_by_pol" string="POL" context="{'group_by': 'ca_diff_pod_1'}"/>
                <filter name="studio_group_by_etd" string="ETD" context="{'group_by': 'ca_diff_date_depart'}"/>
                <filter name="studio_group_by_embarquement" string="Embarquement" context="{'group_by': 'ca_diff_embarquement'}"/>
            </xpath>
        </field>
    </record>

    <!-- purchase.order.line list view -->
    <record id="view_purchase_order_line_list_studio" model="ir.ui.view">
        <field name="name">purchase.order.line.list.studio</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="qty_received"/>
                <field name="qty_invoiced"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
