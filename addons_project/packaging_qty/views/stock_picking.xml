<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_form_stock_picking_add_pack_info" model="ir.ui.view">
            <field name="name">stock picking tree view add pack_info</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="model">stock.picking</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
			    <!--move.line tree 视图中添加pack信息-->
                <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_packaging_id']" position="after">
                    <field name="packaging_qty" attrs="{'invisible':[('product_packaging_id','=',False)]}"/>
			    </xpath>
            </field>
        </record>
</odoo>
