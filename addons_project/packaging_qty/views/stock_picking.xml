<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_form_stock_picking_add_pack_info" model="ir.ui.view">
            <field name="name">stock picking tree view add pack_info</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="model">stock.picking</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_packaging_id']" position="after">
                    <field name="packaging_qty" invisible="not product_packaging_id"/>
			    </xpath>
            </field>
        </record>
</odoo>
