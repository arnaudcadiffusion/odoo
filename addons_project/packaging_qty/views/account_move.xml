<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_account_invoice_add_pack_info" model="ir.ui.view">
        <field name="name">account invoice tree view add pack_info</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="before">
                <field name="product_uom_ids" column_invisible="True"/>
                <field name="product_packaging_id" invisible="not product_id" domain="[('id','in',product_uom_ids)]" options="{'no_create': True}"/>
                <field name="packaging_qty" invisible="not product_packaging_id"/>
            </xpath>
        </field>
    </record>
</odoo>
