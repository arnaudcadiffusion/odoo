<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_form_sale_order_add_tender" model="ir.ui.view">
	    <field name="name">Sale Add Tender</field>
	    <field name="priority">100</field>
	    <field name="inherit_id" ref="sale.view_order_form"/>
	    <field name="model">sale.order</field>
	    <field name="type">form</field>
	    <field name="arch" type="xml">
		    <xpath expr="//page[@name='other_information']" position="after">
			    <page name="Tender Orders" string="Tender Orders">
				    <field name="tender_ids" mode="list,form" readonly='1'>
					    <list string="Tender Orders">
						    <field name="name"/>
						    <field name="state"/>
						    <field name="end_of_the_tender"/>
						    <field name="tender_pricelist_id"/>
						    <field name="start_date"/>
						    <field name="end_date"/>
					    </list>
				    </field>
			    </page>
		</xpath>
		<xpath expr="//form[1]/sheet[1]/notebook[1]" position="after">
			<group name="instructions facturation" string="Instructions Facturation">
				<group>
					<field name="tender_info"/>
				</group>
			</group>
		</xpath>
	    </field>
	</record>
</odoo>
