<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="tender_order_list_view">
        <field name="name">Tender Order List</field>
        <field name="model">tender.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="tender_pricelist_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_tender_order_form" model="ir.ui.view">
        <field name="name">Tender Order Form</field>
        <field name="model">tender.order</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Tender Order">
                <header>
                    <button name="action_confirm" id="action_confirm" type="object"
                        string="Validate" class="btn-primary"
                        invisible="state == 'confirm'"/>
                    <button name="action_reset" id="action_reset" type="object"
                        string="Reset" class="btn-primary"
                        invisible="state == 'draft'"/>
                    <button name="analyze_exist_product_pricelist"
                        id="action_analyze_product_pricelist" type="object"
                        string="Analyze" class="btn-primary"
                        invisible="tender_price_lines != []"
                        />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tender No ..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="end_of_the_tender" />
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="next_revision_date" />
                            <field name="last_revision_date" />
                            <field name="tender_pricelist_id" />
                            <field name="note" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Price Lines">
                            <field name="tender_price_lines" mode="tree,form"
                                readonly="state in ('confirm')">
                                <list string="Tender Order Lines" editable="bottom">
                                    <field name="product_id" />
                                    <field name="min_quantity" />
                                    <field name="revision_price" />
                                </list>
                            </field>
                        </page>
                        <page string="Customer">
                            <field name="partner_ids" mode="tree,form"
                                readonly="state in ['confirm']">
                                <list string="Partners" editable="bottom">
                                    <field name="name" />
                                    <field name="property_product_pricelist" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id='view_tender_order_filter' model='ir.ui.view'>
        <field name="name">tender.order.list.select</field>
        <field name="model">tender.order</field>
        <field name="priority" eval="15" />
        <field name="arch" type="xml">
            <search string="Search Tender Order">
                <field name='name' string='Tender Order' filter_domain="[('name','ilike',self)]" />
                <field name='tender_price_lines' string='Order Line'
                    filter_domain="[('tender_price_lines.product_id','ilike',self)]" />
                <filter name='draft' string='Draft' domain="[('state','=','draft')]" />
                <filter name='confirm' string='Confirm' domain="[('state','=','confirm')]" />
            </search>
        </field>
    </record>

    <record id="action_tender_order" model="ir.actions.act_window">
        <field name="name">Tender</field>
        <field name="res_model">tender.order</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_tender_root"
        name="Tender Order"
        action="action_tender_order"
        parent="sale.sale_menu_root"
        sequence="5" />


</odoo>