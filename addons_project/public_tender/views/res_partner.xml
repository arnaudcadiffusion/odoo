<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_form_partner_add_tender" model="ir.ui.view">
	    <field name="name">Partner Add Tender</field>
	    <field name="priority">100</field>
	    <field name="inherit_id" ref="base.view_partner_form"/>
	    <field name="model">res.partner</field>
	    <field name="type">form</field>
	    <field name="arch" type="xml">
		    <xpath expr="//page[@name='sales_purchases']" position="after">
			    <page name="Tender Orders" string="Tender Orders">
				    <field name="tender_ids" mode="list,form">
					    <list string="Tender Orders" editable="bottom">
						    <field name="name"/>
						    <field name="state"/>
						    <field name="end_of_the_tender"/>
						    <field name="tender_pricelist_id"/>
						    <field name="start_date"/>
						    <field name="end_date"/>
					    </list>
				    </field>
			    </page>
		</xpath>
	    </field>
	</record>
</odoo>
