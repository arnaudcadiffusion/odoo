<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_inherit_label_print" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.label.print</field>
    <field name="model">res.config.settings</field>
    <field name="active" eval="True"/>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='shipping_setting_container']" position="after">
        <block title="Label Printing &amp; Transport" name="label_printing_setting_container">
          <setting id="picking_label_print_server" string="Label Print Server URL" help="Configure the webhook URL for printing picking labels">
            <field name="picking_label_print_server_url" placeholder="e.g. https://your-server.com/api/print-label" class="oe_inline"/>
          </setting>
          <setting id="picking_transport_server" string="Transport Server URL" help="Configure the webhook URL for triggering transport">
            <field name="picking_transpot_server_url" placeholder="e.g. https://your-server.com/api/transport" class="oe_inline"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
