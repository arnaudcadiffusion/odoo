<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="wizard_label_print_message_form" model="ir.ui.view">
    <field name="name">Message</field>
    <field name="model">wizard.label.print.message</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <form>
        <field name="message" readonly="1"/>
        <footer>
          <button string="Close" class="btn-secondary" special="cancel" data-hotkey="z"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="wizard_label_print_message_action" model="ir.actions.act_window">
    <field name="name">Message</field>
    <field name="res_model">wizard.label.print.message</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>