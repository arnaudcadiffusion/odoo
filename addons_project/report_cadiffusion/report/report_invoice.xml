<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =========================================================== -->
        <!-- Main invoice: 7-column (DESCRIPTION|CARTON|UNITE|QTY|PU|TAX|MNT) -->
        <!-- =========================================================== -->
        <template id="report_invoice_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang': lang})"/>
                <t t-set="address">
                    <address t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                        style="font-size: smaller;"/>
                    <div t-if="o.partner_id.vat" class="mt8" style="font-size: smaller;">
                        <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/>
                    </div>
                </t>
                <div class="page" style="font-size: smaller;">

                    <h2>
                        <span t-if="o.move_type == 'out_invoice' and o.state in ('posted', 'in_payment', 'paid')">Facture </span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Facture en brouillon </span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée </span>
                        <span t-if="o.move_type == 'out_refund'">Avoir </span>
                        <span t-if="o.move_type == 'in_refund'">Avoir fournisseur </span>
                        <span t-if="o.move_type == 'in_invoice'">Facture fournisseur </span>
                        <span t-field="o.name"/>
                    </h2>

                    <!-- Info header: 2 rows × 4 cols -->
                    <t t-set="all_so" t-value="o._report_sale_order()"/>
                    <div style="overflow:hidden; margin-top:8px; margin-bottom:4px;">
                        <div style="float:left; width:25%; vertical-align:top; padding-bottom:4px;">
                            <t t-if="o.partner_id.ref">
                                <strong>N# Partenaire:</strong><br/>
                                <span t-field="o.partner_id.ref"/>
                            </t>
                        </div>
                        <div style="float:left; width:25%; vertical-align:top; padding-bottom:4px;">
                            <strong>Date de commande:</strong><br/>
                            <span t-esc="o._report_sale_order_date() and o._report_sale_order_date().strftime('%d/%m/%Y') or ''"/>
                        </div>
                        <div style="float:left; width:25%; vertical-align:top; padding-bottom:4px;">
                            <strong>Date d'expédition:</strong><br/>
                            <span t-esc="o._report_sale_effective_date() and o._report_sale_effective_date().strftime('%d/%m/%Y') or ''"/>
                        </div>
                        <div style="float:left; width:25%;"/>
                    </div>
                    <div style="clear:both;"/>
                    <div style="overflow:hidden; margin-bottom:8px;">
                        <div style="float:left; width:25%; vertical-align:top;">
                            <strong>Référence fournisseur:</strong><br/>
                            <t t-if="all_so"><span t-esc="all_so[0].name"/></t>
                            <t t-else=""><span t-field="o.invoice_origin"/></t>
                        </div>
                        <div style="float:left; width:25%; vertical-align:top;">
                            <strong>Date de la facture:</strong><br/>
                            <span t-field="o.invoice_date"/>
                        </div>
                        <div style="float:left; width:25%; vertical-align:top;">
                            <strong>Date d'échéance:</strong><br/>
                            <span t-field="o.invoice_date_due"/>
                        </div>
                        <div style="float:left; width:25%; vertical-align:top;">
                            <t t-if="all_so and all_so[0].client_order_ref">
                                <strong>Votre référence:</strong><br/>
                                <span t-esc="all_so[0].client_order_ref"/>
                            </t>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- Product table: 5 columns -->
                    <table class="table table-sm table-bordered" name="invoice_line_table">
                        <thead>
                            <tr t-attf-style="background-color:#{o.company_id.primary_color}; color:white;">
                                <th class="text-start">DESCRIPTION</th>
                                <th class="text-end">QUANTITÉ</th>
                                <th class="text-end">PRIX UNIT</th>
                                <th class="text-start">TAXES</th>
                                <th class="text-end">MONTANT</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                <t t-if="line.display_type == 'product'">
                                    <tr>
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit_reduced"/>
                                        </td>
                                        <td class="text-start">
                                            <span t-esc="', '.join(map(lambda x: x.description or x.name, line.tax_ids))"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type in ('line_section', 'line_subsection')">
                                    <tr class="bg-200 fw-bold">
                                        <td colspan="5"><span t-field="line.name"/></td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <tr class="fst-italic">
                                        <td colspan="5"><span t-field="line.name"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totaux -->
                    <div style="overflow:hidden; margin-top:8px;">
                        <div id="total" style="float:right; width:45%;">
                            <table class="table table-sm table-bordered" style="width:100%;">
                                <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                                <t t-call="account.document_tax_totals"/>
                                <t t-if="print_with_payments">
                                    <t t-if="o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr t-if="payment_vals['is_exchange'] == 0">
                                                <td>
                                                    <i class="oe_payment_label">Payé le <t t-esc="payment_vals['date']" t-options='{"widget": "date"}'/></i>
                                                </td>
                                                <td class="text-end">
                                                    <span t-esc="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) > 0">
                                            <tr>
                                                <td><strong>Montant restant dû</strong></td>
                                                <td class="text-end">
                                                    <strong><span t-field="o.amount_residual"/></strong>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <t t-if="o.narration" name="comment">
                        <p><span t-field="o.narration"/></p>
                    </t>
                    <t t-if="o.invoice_payment_term_id" name="payment_term">
                        <p><span t-field="o.invoice_payment_term_id.note"/></p>
                    </t>
                    <t t-if="o.fiscal_position_id.note" name="note">
                        <p><span t-field="o.fiscal_position_id.note"/></p>
                    </t>
                </div>
            </t>
        </template>

        <!-- =========================================================== -->
        <!-- TCARE invoice: 2-column (LIBELLÉ | MONTANT)                  -->
        <!-- =========================================================== -->
        <template id="report_invoice_tcare_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang': lang})"/>
                <t t-set="address">
                    <address t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                        style="font-size: smaller;"/>
                    <div t-if="o.partner_id.vat" class="mt8" style="font-size: smaller;">
                        <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/>
                    </div>
                </t>
                <div class="page" style="font-size: smaller;">

                    <!-- Info box -->
                    <div style="overflow:hidden; margin-top:8px; margin-bottom:16px;">
                        <div style="float:left; width:33%; text-align:center; padding:6px;">
                            <strong>Facture :</strong><br/>
                            <span t-field="o.name"/>
                        </div>
                        <div style="float:left; width:33%; text-align:center; padding:6px;">
                            <strong>Date de facturation :</strong><br/>
                            <span t-field="o.invoice_date"/>
                        </div>
                        <div style="float:left; width:34%; text-align:center; padding:6px;">
                            <strong>Date d'échéance :</strong><br/>
                            <span t-field="o.invoice_date_due"/>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- 2-column table -->
                    <table class="table table-sm table-bordered" name="invoice_line_table">
                        <thead>
                            <tr t-attf-style="background-color:#{o.company_id.primary_color}; color:white;">
                                <th class="text-start">LIBELLÉ</th>
                                <th class="text-end" style="width:15%;">MONTANT</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                <t t-if="line.display_type == 'product'">
                                    <tr>
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type in ('line_section', 'line_subsection')">
                                    <tr class="bg-200 fw-bold">
                                        <td colspan="2"><span t-field="line.name"/></td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <tr class="fst-italic">
                                        <td colspan="2"><span t-field="line.name"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totaux avec paiements -->
                    <div style="overflow:hidden; margin-top:8px;">
                        <div id="total" style="float:right; width:45%;">
                            <table class="table table-sm table-bordered" style="width:100%;">
                                <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                                <t t-call="account.document_tax_totals"/>
                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                            <td>
                                                <i class="oe_payment_label">Payé le <t t-esc="payment_vals['date']" t-options='{"widget": "date"}'/></i>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="len(payments_vals) > 0">
                                        <tr>
                                            <td><strong>Montant restant dû</strong></td>
                                            <td class="text-end">
                                                <strong><span t-field="o.amount_residual"/></strong>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <t t-if="o.narration" name="comment">
                        <p><span t-field="o.narration"/></p>
                    </t>
                    <t t-if="o.invoice_payment_term_id" name="payment_term">
                        <p><span t-field="o.invoice_payment_term_id.note"/></p>
                    </t>
                    <t t-if="o.fiscal_position_id.note" name="note">
                        <p><span t-field="o.fiscal_position_id.note"/></p>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="report_cadiffusion.report_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <template id="report_invoice_with_payments">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-set="print_with_payments" t-value="True"/>
                    <t t-call="report_cadiffusion.report_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
