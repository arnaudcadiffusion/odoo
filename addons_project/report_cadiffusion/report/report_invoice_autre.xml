<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================== -->
        <!-- Factures Autre / Facture TCARE                     -->
        <!-- Colonnes : Description | Qté | P.U. | Taxes | Montant -->
        <!-- ================================================== -->

        <template id="report_invoice_autre_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang': lang})"/>
                <t t-set="address">
                    <address t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                        style="font-size: smaller;"/>
                    <div t-if="o.partner_id.vat" class="mt16" style="font-size: smaller;">
                        <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/>
                    </div>
                </t>
                <div class="page" style="font-size: smaller;">

                    <h2>
                        <t t-if="report_label">
                            <span t-esc="report_label"/>
                        </t>
                        <t t-else="">
                            <span t-if="o.move_type == 'out_invoice' and o.state in ('posted', 'in_payment', 'paid')">Facture</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Facture en brouillon</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Facture annulée</span>
                            <span t-if="o.move_type == 'out_refund'">Avoir</span>
                            <span t-if="o.move_type == 'in_refund'">Avoir de fournisseur</span>
                            <span t-if="o.move_type == 'in_invoice'">Facture fournisseur</span>
                        </t>
                        <span t-field="o.name"/>
                    </h2>

                    <!-- Info header -->
                    <t t-set="all_so" t-value="o._report_sale_order()"/>
                    <div class="row mt16 mb8">
                        <div class="col-3" t-if="o.partner_id.ref">
                            <strong>N# Partenaire:</strong><br/>
                            <span t-field="o.partner_id.ref"/>
                        </div>
                        <div class="col-3">
                            <strong>Date de commande:</strong><br/>
                            <span t-esc="o._report_sale_order_date() and o._report_sale_order_date().strftime('%d/%m/%Y') or ''"/>
                        </div>
                        <div class="col-3">
                            <strong>Date de livraison:</strong><br/>
                            <span t-esc="o._report_sale_effective_date() and o._report_sale_effective_date().strftime('%d/%m/%Y') or ''"/>
                        </div>
                    </div>
                    <div class="row mb16">
                        <div class="col-3">
                            <strong>Réf. fournisseur:</strong><br/>
                            <t t-if="all_so"><span t-esc="all_so[0].name"/></t>
                            <t t-else=""><span t-field="o.invoice_origin"/></t>
                        </div>
                        <div class="col-3">
                            <strong>Date de la facture:</strong><br/>
                            <span t-field="o.invoice_date"/>
                        </div>
                        <div class="col-3">
                            <strong>Date d'échéance:</strong><br/>
                            <span t-field="o.invoice_date_due"/>
                        </div>
                        <div class="col-3" t-if="all_so and all_so[0].client_order_ref">
                            <strong>Votre référence:</strong><br/>
                            <span t-esc="all_so[0].client_order_ref"/>
                        </div>
                    </div>

                    <!-- Tableau des lignes -->
                    <t t-set="article_cmd_flag" t-value="any([l.article_cmd for l in o.invoice_line_ids])"/>
                    <table class="table table-sm table-bordered" name="invoice_line_table">
                        <thead>
                            <tr>
                                <t t-set="colspan" t-value="5"/>
                                <th class="text-start">Description</th>
                                <th class="text-end">Quantité</th>
                                <th class="text-end">P.U. / pièce</th>
                                <th class="text-start">Taxes</th>
                                <t t-if="article_cmd_flag">
                                    <th>Article cmdé</th>
                                    <t t-set="colspan" t-value="6"/>
                                </t>
                                <th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: l.sequence)" t-as="line">
                                <tr t-att-class="'bg-200 fw-bold' if line.display_type in ('line_section', 'line_subsection') else 'fst-italic' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product'">
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit_reduced"/>
                                        </td>
                                        <td class="text-start">
                                            <span t-esc="', '.join([x.invoice_label or x.name for x in line.tax_ids])"/>
                                        </td>
                                        <t t-if="article_cmd_flag">
                                            <td><span t-field="line.article_cmd"/></td>
                                        </t>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </t>
                                    <t t-elif="line.display_type in ('line_section', 'line_subsection', 'line_note')">
                                        <td t-att-colspan="colspan">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totaux -->
                    <div style="overflow:hidden; margin-top:8px;">
                        <div id="total" style="float:right; width:45%;">
                            <table class="table table-sm table-bordered" style="width:100%;">
                                <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                                <t t-call="account.document_tax_totals"/>
                            </table>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- Notes -->
                    <t t-if="o.narration" name="comment">
                        <p><span t-field="o.narration"/></p>
                    </t>
                    <t t-if="o.invoice_payment_term_id" name="payment_term">
                        <p><span t-field="o.invoice_payment_term_id.note"/></p>
                    </t>
                    <t t-if="o.fiscal_position_id.note" name="note">
                        <p><span t-field="o.fiscal_position_id.note"/></p>
                    </t>
                </div>
            </t>
        </template>

        <template id="report_invoice_autre">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="report_cadiffusion.report_invoice_autre_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <template id="report_invoice_tcare">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="report_cadiffusion.report_invoice_tcare_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <!-- Report actions — created here so they work on fresh install without migrations -->
        <record id="action_report_invoice_autre" model="ir.actions.report">
            <field name="name">Factures Autre</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">report_cadiffusion.report_invoice_autre</field>
            <field name="report_file">report_cadiffusion.report_invoice_autre</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_invoice_tcare" model="ir.actions.report">
            <field name="name">Facture TCARE</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">report_cadiffusion.report_invoice_tcare</field>
            <field name="report_file">report_cadiffusion.report_invoice_tcare</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
