<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Bon de livraison - Rupture : toutes les lignes de la demande, mais
         COLIS = cartons entiers (arrondi supérieur) calculés depuis la quantité
         RÉSERVÉE (une ligne non réservée sort sans colis) et Total Colis = somme
         des colis affichés. Conditionnement : uniquement l'UDM d'emballage
         du move (packaging_uom_id, héritée de la ligne de vente/achat = le
         « Colis » du backoffice) ; si le move n'en porte pas (UDM pièce),
         colonnes vides. -->
    <template id="report_delivery_document_reserved">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang': o.partner_id.lang})"/>

                <!-- Adresse de livraison -->
                <t t-if="o.move_ids and o.move_ids[0].partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.move_ids[0].partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </t>
                </t>
                <t t-elif="o.partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </t>
                </t>

                <!-- Styles : rendu boxed v15 (voir report_delivery_order.xml) -->
                <t t-set="cad_border" t-value="'border: 1px solid #495057;'"/>
                <t t-set="cad_th_style" t-value="cad_border + ' border-bottom: 2px solid #495057; text-transform: uppercase; color: %s;' % (o.company_id.secondary_color or 'black')"/>
                <div class="page">
                    <h2><span t-field="o.name" t-attf-style="color: {{ o.company_id.primary_color or 'black' }};"/></h2>

                    <!-- Statut BL : Groupé (icône, nb de BL, liste des BL groupés) / Non groupé (v15) -->
                    <div class="row small">
                        <div class="col-12">
                            <t t-if="o.x_studio_bl_groupe">
                                <div style="font-size: 14px; font-weight: bold;">
                                    <span style="font-size: 18px; margin-right: 4px;">&#9888;</span>
                                    <strong>Statut BL :</strong>
                                    Groupé
                                    <t t-if="o.x_studio_nb_bl_groupe">
                                        – <span t-esc="o.x_studio_nb_bl_groupe"/> BL
                                    </t>
                                </div>
                                <t t-if="o.x_studio_id_bl_groupe">
                                    <div style="margin-top: 3px; margin-left: 20px;">
                                        <strong>BL groupés :</strong><br/>
                                        <span t-esc="o.x_studio_id_bl_groupe" style="white-space: pre-line;"/>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <strong>Statut BL :</strong>
                                Non groupé
                            </t>
                        </div>
                    </div>

                    <!-- En-tête : 5 colonnes sur une ligne (en float : la grille
                         flex n'est pas rendue par wkhtmltopdf) -->
                    <div style="margin-top:8px; margin-bottom:8px; overflow:hidden;">
                        <div style="float:left; width:20%;">
                            <strong>N# Partenaire:</strong><br/>
                            <span t-field="o.x_studio_n_partenaire"/>
                        </div>
                        <div style="float:left; width:20%;">
                            <strong>Date commande:</strong><br/>
                            <span t-field="o.create_date" t-options-widget="&quot;date&quot;"/>
                        </div>
                        <div style="float:left; width:20%;">
                            <strong>Date livraison:</strong><br/>
                            <span t-field="o.scheduled_date" t-options-widget="&quot;date&quot;"/>
                        </div>
                        <div style="float:left; width:20%;">
                            <strong>Votre reference:</strong><br/>
                            <span t-field="o.x_studio_n_commande"/>
                        </div>
                        <div style="float:left; width:20%;">
                            <strong>Bon Commande:</strong><br/>
                            <span t-field="o.sale_id.name"/>
                        </div>
                    </div>

                    <!-- ATTENTION / IMPORTANT -->
                    <div class="mb-2">
                        <span>
                            <b>ATTENTION :</b> Veuillez vérifier<br/>
                            1- L'existence d'une bande de garantie<br/>
                            2- Le nombre et l'état des colis<br/>
                            3- Émettre des réserves sur le bordereau du transporteur si nécessaire<br/>
                            <b>IMPORTANT :</b> Aucune réclamation ne pourra être prise sans réserves précises sur le bon de transport. Merci de votre compréhension
                        </span>
                    </div>

                    <!-- PALETTES EUROPE -->
                    <div class="mb-3">
                        <span>
                            <b>PALETTES EUROPE :</b> Les palettes Europe mises à disposition doivent être restituées dans les meilleurs délais.<br/>
                            À défaut de restitution, une facturation de 10 EUROS par palette non retournée sera appliquée.
                        </span>
                    </div>

                    <!-- Table : mouvements non validés (quantités réservées) -->
                    <t t-set="article_cmd_flag" t-value="any(m.article_cmd for m in o.move_ids)"/>
                    <t t-set="total_colis" t-value="0"/>
                    <table class="table table-sm mt-3" t-if="o.state != 'done'"
                           t-att-style="cad_border + ' color: #495057;'">
                        <thead>
                            <tr>
                                <th t-att-style="cad_th_style"><strong>ARTICLE</strong></th>
                                <th t-att-style="cad_th_style"><strong>COLIS</strong></th>
                                <th t-att-style="cad_th_style"><strong>CONDITIONNEMENT</strong></th>
                                <th t-att-style="cad_th_style"><strong>QUANTITÉ</strong></th>
                                <th t-if="article_cmd_flag" t-att-style="cad_th_style"><strong>Article cmdé</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_ids.filtered(lambda m: m.product_uom_qty)" t-as="move">
                                <tr t-if="move.note_text">
                                    <td t-att-colspan="5 if article_cmd_flag else 4" t-att-style="cad_border">
                                        <span t-field="move.note_text"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td t-att-style="cad_border">
                                        <span t-field="move.product_id"/>
                                        <p t-if="o.picking_type_code == 'outgoing'">
                                            <span t-field="move.product_id.sudo().description_pickingout"/>
                                        </p>
                                        <p t-if="o.picking_type_code == 'incoming'">
                                            <span t-field="move.product_id.sudo().description_pickingin"/>
                                        </p>
                                    </td>
                                    <td t-att-style="cad_border">
                                        <!-- Cartons entiers depuis le réservé : ceil(réservé / qté par carton), comme le v15. -->
                                        <t t-set="base_uom" t-value="move.product_id.uom_id"/>
                                        <t t-set="carton_uom" t-value="move.packaging_uom_id.filtered(lambda u: u.factor and base_uom.factor and u.factor > base_uom.factor)"/>
                                        <t t-set="colis_f" t-value="move.product_uom._compute_quantity(move.quantity, carton_uom, round=False) if carton_uom else 0"/>
                                        <t t-set="colis" t-value="int(colis_f) + (1 if round(colis_f % 1, 6) else 0)"/>
                                        <t t-if="colis">
                                            <span t-out="colis"/>
                                            <t t-set="total_colis" t-value="total_colis + colis"/>
                                        </t>
                                    </td>
                                    <td t-att-style="cad_border"><span t-out="carton_uom.name or ''"/></td>
                                    <td t-att-style="cad_border + ('' if article_cmd_flag else ' background-color: #e9ecef;')">
                                        <span t-field="move.product_uom_qty"/>
                                        <span t-field="move.product_uom"/>
                                    </td>
                                    <td t-if="article_cmd_flag" t-att-style="cad_border + ' background-color: #e9ecef;'">
                                        <span t-field="move.article_cmd"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Total Colis (non validé) : somme des colis des lignes affichées (v15) -->
                    <t t-if="o.state != 'done'">
                        <table class="table table-sm" style="width:40%; float:right;" t-if="total_colis">
                            <tr>
                                <td t-attf-style="background-color: rgba(0,0,0,0.9); color: {{ o.company_id.primary_color or '#fff' }}; font-weight:bold; border: 1px solid #495057;">Total Colis</td>
                                <td style="background-color: rgba(0,0,0,0.9); color:#fff; text-align:right; font-weight:bold; border: 1px solid #495057;">
                                    <t t-esc="int(total_colis)"/>
                                </td>
                            </tr>
                        </table>
                        <div style="clear:both;"/>
                    </t>

                    <!-- Table : mouvements validés (done) -->
                    <t t-set="article_flag" t-value="any(ml.move_id.article_cmd for ml in o.move_line_ids)"/>
                    <t t-set="total_colis_done" t-value="0"/>
                    <table class="table table-sm mt-3" t-if="o.move_line_ids and o.state == 'done'"
                           t-att-style="cad_border + ' color: #495057;'">
                        <t t-set="has_lot" t-value="o.move_line_ids.mapped('lot_id')"/>
                        <thead>
                            <tr>
                                <th t-att-style="cad_th_style"><strong>ARTICLE</strong></th>
                                <th t-if="has_lot" groups="stock.group_lot_on_delivery_slip" t-att-style="cad_th_style">Lot/N° Série</th>
                                <th t-att-style="cad_th_style"><strong>COLIS</strong></th>
                                <th t-att-style="cad_th_style"><strong>CONDITIONNEMENT</strong></th>
                                <th t-att-style="cad_th_style"><strong>QUANTITÉ</strong></th>
                                <th t-if="article_flag" t-att-style="cad_th_style"><strong>Article cmdé</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_line_ids" t-as="move_line">
                                <tr t-if="move_line.move_id.note_text">
                                    <td t-att-colspan="6 if article_flag else 5" t-att-style="cad_border">
                                        <span t-field="move_line.move_id.note_text"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td t-att-style="cad_border">
                                        <span t-field="move_line.product_id"/>
                                        <p t-if="o.picking_type_code == 'outgoing'">
                                            <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                        </p>
                                        <p t-if="o.picking_type_code == 'incoming'">
                                            <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                        </p>
                                    </td>
                                    <td t-if="has_lot" groups="stock.group_lot_on_delivery_slip" t-att-style="cad_border">
                                        <span t-field="move_line.lot_name"/>
                                    </td>
                                    <td t-att-style="cad_border">
                                        <t t-set="base_uom" t-value="move_line.product_id.uom_id"/>
                                        <t t-set="carton_uom" t-value="move_line.move_id.packaging_uom_id.filtered(lambda u: u.factor and base_uom.factor and u.factor > base_uom.factor)"/>
                                        <t t-set="colis_f" t-value="move_line.product_uom_id._compute_quantity(move_line.quantity, carton_uom, round=False) if carton_uom else 0"/>
                                        <t t-set="colis_done" t-value="int(colis_f) + (1 if round(colis_f % 1, 6) else 0)"/>
                                        <t t-if="colis_done">
                                            <span t-out="colis_done"/>
                                            <t t-set="total_colis_done" t-value="total_colis_done + colis_done"/>
                                        </t>
                                    </td>
                                    <td t-att-style="cad_border"><span t-out="carton_uom.name or ''"/></td>
                                    <td class="text-center" t-att-style="cad_border + ('' if article_flag else ' background-color: #e9ecef;')">
                                        <span t-field="move_line.quantity"/>
                                        <span t-field="move_line.product_uom_id"/>
                                    </td>
                                    <td t-if="article_flag" t-att-style="cad_border + ' background-color: #e9ecef;'">
                                        <span t-field="move_line.move_id.article_cmd"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Total Colis (validé) : somme des colis des lignes affichées -->
                    <t t-if="o.state == 'done'">
                        <table class="table table-sm" style="width:40%; float:right;" t-if="total_colis_done">
                            <tr>
                                <td t-attf-style="background-color: rgba(0,0,0,0.9); color: {{ o.company_id.primary_color or '#fff' }}; font-weight:bold; border: 1px solid #495057;">Total Colis</td>
                                <td style="background-color: rgba(0,0,0,0.9); color:#fff; text-align:right; font-weight:bold; border: 1px solid #495057;">
                                    <t t-esc="int(total_colis_done)"/>
                                </td>
                            </tr>
                        </table>
                        <div style="clear:both;"/>
                    </t>

                    <!-- Reliquat (v15) -->
                    <!-- 3.a) avant validation : lignes dont demandé > préparé/réservé (quantity) -->
                    <t t-if="o.state != 'done'">
                        <t t-set="remaining_moves" t-value="o.move_ids.filtered(lambda m: m.product_uom_qty and round(m.product_uom_qty - m.quantity, 6) > 0)"/>
                        <t t-if="remaining_moves">
                            <p>Tous les articles n'ont pas pu être expédiés, le reliquat de votre commande sera expédié séparément.</p>
                            <table class="table table-sm" t-att-style="cad_border + ' color: #495057;'">
                                <thead>
                                    <tr>
                                        <th t-att-style="cad_th_style"><strong>ARTICLE</strong></th>
                                        <th t-att-style="cad_th_style"><strong>COLIS</strong></th>
                                        <th t-att-style="cad_th_style"><strong>À EXPÉDIER</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="remaining_moves" t-as="rmove">
                                        <t t-set="r_remaining" t-value="rmove.product_uom_qty - rmove.quantity"/>
                                        <td t-att-style="cad_border">
                                            <span t-field="rmove.product_id"/>
                                        </td>
                                        <td t-att-style="cad_border">
                                            <t t-set="r_base_uom" t-value="rmove.product_id.uom_id"/>
                                            <t t-set="r_carton_uom" t-value="rmove.packaging_uom_id.filtered(lambda u: u.factor and r_base_uom.factor and u.factor > r_base_uom.factor)"/>
                                            <t t-set="r_colis_f" t-value="rmove.product_uom._compute_quantity(r_remaining, r_carton_uom, round=False) if r_carton_uom else 0"/>
                                            <t t-set="r_colis" t-value="int(r_colis_f) + (1 if round(r_colis_f % 1, 6) else 0)"/>
                                            <span t-if="r_colis" t-out="r_colis"/>
                                        </td>
                                        <td t-att-style="cad_border + ' background-color: #e9ecef;'">
                                            <span t-out="int(round(r_remaining, 6))"/>
                                            <span t-field="rmove.product_uom"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>

                    <!-- 3.b) après validation : lignes des reliquats créés (backorders) -->
                    <t t-if="o.state == 'done' and o.backorder_ids">
                        <t t-set="reliquat_moves" t-value="o.backorder_ids.move_ids.filtered(lambda m: m.product_uom_qty)"/>
                        <t t-if="reliquat_moves">
                            <p>Tous les articles n'ont pas pu être expédiés, le reliquat de votre commande sera expédié séparément.<br/>Merci pour votre compréhension</p>
                            <table class="table table-sm" t-att-style="cad_border + ' color: #495057;'">
                                <thead>
                                    <tr>
                                        <th t-att-style="cad_th_style"><strong>ARTICLE</strong></th>
                                        <th t-att-style="cad_th_style"><strong>COLIS</strong></th>
                                        <th t-att-style="cad_th_style"><strong>À EXPÉDIER</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="reliquat_moves" t-as="bmove">
                                        <td t-att-style="cad_border">
                                            <span t-field="bmove.product_id"/>
                                        </td>
                                        <td t-att-style="cad_border">
                                            <t t-set="b_base_uom" t-value="bmove.product_id.uom_id"/>
                                            <t t-set="b_carton_uom" t-value="bmove.packaging_uom_id.filtered(lambda u: u.factor and b_base_uom.factor and u.factor > b_base_uom.factor)"/>
                                            <t t-set="b_colis_f" t-value="bmove.product_uom._compute_quantity(bmove.product_uom_qty, b_carton_uom, round=False) if b_carton_uom else 0"/>
                                            <t t-set="b_colis" t-value="int(b_colis_f) + (1 if round(b_colis_f % 1, 6) else 0)"/>
                                            <span t-if="b_colis" t-out="b_colis"/>
                                        </td>
                                        <td t-att-style="cad_border + ' background-color: #e9ecef;'">
                                            <span t-field="bmove.product_uom_qty"/>
                                            <span t-field="bmove.product_uom"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>

                    <!-- Message reliquat en cours (anglais) -->
                    <p t-if="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))">
                        All items couldn't be shipped, the remaining ones will be shipped as soon as they become available.
                    </p>

                    <!-- Pied : Instruction Livraison, Notes Internes, Transport, Poids -->
                    <div class="mt-3">
                        <p style="margin-bottom:2px;"><strong>Instruction Livraison :</strong><br/>
                            <span t-field="o.x_studio_livraison"/>
                        </p>
                        <p style="margin-bottom:2px;"><strong>Notes Internes :</strong><br/>
                            <span t-field="o.x_studio_notes_internes"/>
                        </p>
                        <p style="margin-bottom:2px;"><strong>Transport :</strong><br/>
                            <span t-field="o.x_studio_transport"/>
                        </p>
                        <p style="margin-bottom:2px;"><strong>Poids :</strong><br/>
                            <span t-field="o.weight" t-options='{"widget": "float", "digits": [6,2]}'/> Kg
                        </p>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <template id="report_deliveryslip_reserved">
        <t t-foreach="docs" t-as="o">
            <t t-call="report_cadiffusion.report_delivery_document_reserved" t-lang="o.partner_id.lang"/>
        </t>
    </template>
</odoo>
