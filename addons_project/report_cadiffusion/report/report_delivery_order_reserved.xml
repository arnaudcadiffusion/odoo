<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document_reserved">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})" />
                <t t-if="o.move_ids and o.move_ids[0].partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.move_ids[0].partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                   </t>
                </t>
                <t t-if="not (o.move_ids and o.move_ids[0].partner_id) and o.partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </t>
                </t>
                <div class="page">
                    <h2>
                        <span t-field="o.name"/>
                    </h2>
		    <div class="row">
			    <div class="col-3">
				<span>
				<strong>N# Partenaire:</strong>
				<br/>
				</span>
				<!-- <span t-field="o.x_studio_n_partenaire"/> -->
			    </div>
			    <div class="col-3">
			    <span>
				    <strong>Date de commande:</strong>
      <br/>
    </span>
      <span t-field="o.date" t-options-widget="&quot;date&quot;"/>
       </div>
    <div class="col-3">
    <span>
      <strong>Date de livraision:</strong>
      <br/>
      <span t-field="o.scheduled_date" t-options-widget="&quot;date&quot;"/>
    </span>
       </div>
			    <div class="col-3">
			    <span>
			     <strong>Votre reference:</strong>
		     </span>
      <br/>
      <span t-field="o.x_studio_n_commande"/>
       </div>
		    </div>
		    <div class="row">
			    <div class="col-3">
				<span>
				<strong>Reference fournisseur:</strong>
				<br/>
				</span>
				<span t-field="o.sale_id.name"/>
			    </div>
    <div class="col-3">
			    </div>
			    <div class="col-3">
		    </div>
		    </div>
      <br/>
		    <div>
			     <span><b>ATTENTION:</b> Veuillez vérifier<br/>1- L'existence d'une bande de garantie<br/>2- Le nombre et l'état des colis<br/>3- Emettre des réserves sur le bordereau du transporteur si nécessaire<br/><b>IMPORTANT:</b> Aucune réclamation ne pourra être prise sans réserves précises sur le bon de transport. Merci de votre compréhension</span>
		    </div>
			   
		    <t t-set="colspan" t-value="4"/>
		    <t t-set="total_pack_qty" t-value="0"/>
                    <table class="table table-sm mt48" t-if="o.state!='done'">
			    <t t-set="article_cmd_flag" t-value="any([x.article_cmd for x in o.move_ids])"/>
                        <thead>
                            <tr>
				
                                <th><strong>ARTICLE</strong></th>
                                <th><strong>COLIS</strong></th>
                                <th><strong>CONDITIONNEMENT</strong></th>
                                <th><strong>QUANTITY</strong></th>
				<th t-if="article_cmd_flag">
					<strong>Article cmdé</strong>
                                    <t t-set="colspan" t-value="colspan+1"/>
				</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <t t-foreach="lines" t-as="move">
				    <t t-if="move.note_text">
					    <tr>
                                        <td t-att-colspan="colspan">
                                            <span t-field="move.note_text"/>
                                        </td>
				</tr>
                                    </t>
				    <t t-if="move.quantity">
				    <tr>
                                <td>
                                    <span t-field="move.product_id"/>
                                    <p t-if="o.picking_type_code == 'outgoing'">
                                        <span t-field="move.product_id.sudo().description_pickingout"/>
                                    </p>
                                    <p t-if="o.picking_type_code == 'incoming'">
                                        <span t-field="move.product_id.sudo().description_pickingin"/>
                                    </p>
                                </td>
				<td>
					<t t-if="move.quantity">
					 <span t-field="move.packaging_uom_qty"/>
					<t t-set="total_pack_qty" t-value="move.packaging_uom_qty+total_pack_qty"/>
				</t>
					<!-- <t t-elif="move.quantity and move.product_packaging_id">
					<t t-set="qty" t-value="move.quantity"/>
					<t t-set="pack_q" t-value="move.product_packaging_id.qty"/>
					<t t-set="pack_qty" t-value="int(qty//pack_q)+1 if qty%pack_q else int(qty//pack_q)"/>
					<span t-esc="pack_qty"/>
					<t t-set="total_pack_qty" t-value="pack_qty+total_pack_qty"/>
				</t> -->
				</td>
				<td>
					<!-- <span t-field="move.product_packaging_id.display_name"/> -->
				</td>

                                <td>
					 <t t-if="move.quantity">
      <span t-field="move.quantity"/>
    </t>
    <t t-else="">
      <span t-field="move.quantity"/>
    </t>
                                    <span t-field="move.product_uom_id"/>
                                </td>
				<t t-if="article_cmd_flag">
				<td>
                                    <span t-field="move.article_cmd"/>
				</td>
			</t>
				<t t-else="">
			</t>
		</tr>
                            </t>
			    <t t-else="">
			    </t>
		    </t>
                        </tbody>
                    </table>

                    <table class="table table-sm mt48" t-if="o.move_line_ids and o.state=='done'">
                        <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" />
			    <t t-set="article_flag" t-value="any([x.move_id.article_cmd for x in o.move_line_ids])"/>
                        <thead>
                            <tr>
                                <th><strong>ARTICLE</strong></th>
                                <th name="lot_serial" t-if="has_serial_number" groups="stock.group_lot_on_delivery_slip">
                                    Lot/Serial Number
                                </th>
                                <th><strong>COLIS</strong></th>
                                <!-- <th><strong>CONDITIONNEMENT</strong></th>
                                <th><strong>QUANTITY</strong></th> -->
				<th t-if="article_flag">
					<strong>Article cmdé</strong>
                                    <t t-set="colspan" t-value="colspan+1"/>
				</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_line_ids" t-as="move_line">
				    <t t-if="move_line.move_id.note_text">
					    <tr>
                                        <td t-att-colspan="colspan">
                                            <span t-field="move_line.move_id.note_text"/>
                                        </td>
				</tr>
                                    </t>
				    <tr>
                                <td>
                                    <span t-field="move_line.product_id"/>
                                    <p t-if="o.picking_type_code == 'outgoing'">
                                        <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                    </p>
                                    <p t-if="o.picking_type_code == 'incoming'">
                                        <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                    </p>
                                </td>
                                <td t-if="has_serial_number" groups="stock.group_lot_on_delivery_slip">
                                    <span t-field="move_line.lot_name"/>
                                </td>
				<!-- <td>
					 <span t-field="move_line.move_id.packaging_qty"/>
				</td>
				<td>
					<span t-field="move_line.move_id.product_packaging_id.display_name"/>
				</td> -->

                                <td class="text-center">
      <span t-field="move_line.quantity"/>
                                    <span t-field="move_line.product_uom_id"/>
                                </td>
				<t t-if="article_flag">
				<td>
                                    <span t-field="move_line.move_id.article_cmd"/>
				</td>
			</t>
			<t t-else="">
			</t>
                            </tr>
	    </t>
                        </tbody>
                    </table>

                    <div class="clearfix">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">

				<table class="table table-sm" t-if="o.state!='done'">
				    <!-- <tr class="border-black" style="border-bottom:1px solid #dddddd;">
					<td><strong>Total Colis</strong></td>
					<td class="text-right">
                                            <span t-esc="total_pack_qty"/>
					</td>
				    </tr> -->
				</table>

                                <table class="table table-sm" t-if="o.state=='done'">
                                    <!-- <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                                        <td><strong>Total Colis</strong></td>
                                        <td class="text-right">
					    <span t-esc="sum([move.packaging_uom_qty for move in o.move_ids])"/>
                                        </td>
                                    </tr> -->
                                </table>
                            </div>
                        </div>
                    </div>
                    <p>
                        <t t-if="o.backorder_ids and o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))">
                            All items couldn't be shipped, the remaining ones will be shipped as soon as they become available.
                        </t>
                    </p>
                </div>
            </t>
         </t>
    </template>

    <template id="report_deliveryslip_reserved">
        <t t-foreach="docs" t-as="o">
            <t t-call="report_cadiffusion.report_delivery_document_reserved" t-lang="o.partner_id.lang"/>
        </t>
    </template>
</odoo>
