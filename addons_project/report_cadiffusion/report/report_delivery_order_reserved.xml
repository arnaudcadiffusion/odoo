<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Bon de livraison réservé : uniquement les lignes avec quantité réservée ou faite -->
    <template id="report_delivery_document_reserved">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang': o.partner_id.lang})"/>

                <!-- Adresse de livraison : partenaire de la première ligne de mouvement si disponible -->
                <t t-if="o.move_ids and o.move_ids[0].partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.move_ids[0].partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </t>
                </t>
                <t t-elif="o.partner_id" name="partner_header">
                    <t t-set="address">
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                    </t>
                </t>

                <div class="page">
                    <h2><span t-field="o.name"/></h2>

                    <!-- En-tête : informations commande -->
                    <div class="row mb-2">
                        <div class="col-3">
                            <strong>N# Partenaire :</strong><br/>
                        </div>
                        <div class="col-3">
                            <strong>Date de commande :</strong><br/>
                            <span t-field="o.date" t-options-widget="&quot;date&quot;"/>
                        </div>
                        <div class="col-3">
                            <strong>Date de livraison :</strong><br/>
                            <span t-field="o.scheduled_date" t-options-widget="&quot;date&quot;"/>
                        </div>
                        <div class="col-3">
                            <strong>Votre référence :</strong><br/>
                            <span t-field="o.x_studio_n_commande"/>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-3">
                            <strong>Référence fournisseur :</strong><br/>
                            <span t-field="o.sale_id.name"/>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span>
                            <b>ATTENTION :</b> Veuillez vérifier<br/>
                            1- L'existence d'une bande de garantie<br/>
                            2- Le nombre et l'état des colis<br/>
                            3- Émettre des réserves sur le bordereau du transporteur si nécessaire<br/>
                            <b>IMPORTANT :</b> Aucune réclamation ne pourra être prise sans réserves précises sur le bon de transport. Merci de votre compréhension
                        </span>
                    </div>

                    <!-- Table des mouvements en cours (non validé) : quantités réservées uniquement -->
                    <t t-set="article_cmd_flag" t-value="any(m.article_cmd for m in o.move_ids)"/>
                    <table class="table table-sm mt-3" t-if="o.state != 'done'">
                        <thead>
                            <tr>
                                <th><strong>ARTICLE</strong></th>
                                <th><strong>COLIS</strong></th>
                                <th><strong>CONDITIONNEMENT</strong></th>
                                <th><strong>QUANTITÉ</strong></th>
                                <th t-if="article_cmd_flag"><strong>Article cmdé</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Afficher uniquement les lignes avec une quantité réservée -->
                            <t t-foreach="o.move_ids.filtered(lambda m: m.quantity)" t-as="move">
                                <tr t-if="move.note_text">
                                    <td t-att-colspan="5 if article_cmd_flag else 4">
                                        <span t-field="move.note_text"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span t-field="move.product_id"/>
                                        <p t-if="o.picking_type_code == 'outgoing'">
                                            <span t-field="move.product_id.sudo().description_pickingout"/>
                                        </p>
                                        <p t-if="o.picking_type_code == 'incoming'">
                                            <span t-field="move.product_id.sudo().description_pickingin"/>
                                        </p>
                                    </td>
                                    <td><span t-if="move.packaging_uom_qty" t-field="move.packaging_uom_qty"/></td>
                                    <td><span t-if="move.packaging_uom_id" t-field="move.packaging_uom_id"/></td>
                                    <td>
                                        <span t-field="move.quantity"/>
                                        <span t-field="move.product_uom_id"/>
                                    </td>
                                    <td t-if="article_cmd_flag">
                                        <span t-field="move.article_cmd"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Table des mouvements validés (done) : quantités réalisées -->
                    <t t-set="article_flag" t-value="any(ml.move_id.article_cmd for ml in o.move_line_ids)"/>
                    <table class="table table-sm mt-3" t-if="o.move_line_ids and o.state == 'done'">
                        <t t-set="has_lot" t-value="o.move_line_ids.mapped('lot_id')"/>
                        <thead>
                            <tr>
                                <th><strong>ARTICLE</strong></th>
                                <th t-if="has_lot" groups="stock.group_lot_on_delivery_slip">Lot/N° Série</th>
                                <th><strong>COLIS</strong></th>
                                <th><strong>QUANTITÉ</strong></th>
                                <th t-if="article_flag"><strong>Article cmdé</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_line_ids" t-as="move_line">
                                <tr t-if="move_line.move_id.note_text">
                                    <td t-att-colspan="5 if article_flag else 4">
                                        <span t-field="move_line.move_id.note_text"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span t-field="move_line.product_id"/>
                                        <p t-if="o.picking_type_code == 'outgoing'">
                                            <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                        </p>
                                        <p t-if="o.picking_type_code == 'incoming'">
                                            <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                        </p>
                                    </td>
                                    <td t-if="has_lot" groups="stock.group_lot_on_delivery_slip">
                                        <span t-field="move_line.lot_name"/>
                                    </td>
                                    <td><span t-if="move_line.move_id.packaging_uom_qty" t-field="move_line.move_id.packaging_uom_qty"/></td>
                                    <td class="text-center">
                                        <span t-field="move_line.quantity"/>
                                        <span t-field="move_line.product_uom_id"/>
                                    </td>
                                    <td t-if="article_flag">
                                        <span t-field="move_line.move_id.article_cmd"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <p t-if="o.backorder_ids and o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))">
                        Tous les articles n'ont pu être expédiés, les articles restants seront expédiés dès qu'ils seront disponibles.
                    </p>
                </div>
            </t>
        </t>
    </template>

    <template id="report_deliveryslip_reserved">
        <t t-foreach="docs" t-as="o">
            <t t-call="report_cadiffusion.report_delivery_document_reserved" t-lang="o.partner_id.lang"/>
        </t>
    </template>
</odoo>
