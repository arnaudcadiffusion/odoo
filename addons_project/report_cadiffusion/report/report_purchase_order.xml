<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_purchaseorder_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        <t t-set="address">
            <div t-field="o.partner_id"
            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>
        </t>
        <t t-if="o.dest_address_id">
            <t t-set="information_block">
                <strong>Shipping address:</strong>
                <div t-if="o.dest_address_id">
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                </div>

            </t>
        </t>
        <!-- Styles : reproduit le rendu boxed v15 (grille sombre, entêtes en
             couleur secondaire société, dernière colonne grisée, Total sur
             fond noir), que le CSS boxed v19 ne fournit plus. Le font-size
             80% vient d'un ajustement Studio de la prod. -->
        <t t-set="cad_border" t-value="'border: 1px solid #495057;'"/>
        <t t-set="cad_th_style" t-value="cad_border + ' border-bottom: 2px solid #495057; text-transform: uppercase; color: %s;' % (o.company_id.secondary_color or 'black')"/>
        <div class="page" style="font-size: 80% !important;">
            <div class="oe_structure"/>
            <h2 t-if="o.state != 'cancel'">Order : <span t-field="o.name" t-attf-style="color: {{ o.company_id.primary_color or 'black' }};"/></h2>
            <h2 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h2>
            <!-- Entête dates : reproduit la personnalisation Studio v15 de la
                 prod (libellés d'origine conservés tels quels, typos comprises).
                 Colonnes en float : wkhtmltopdf ne rend pas la grille flex de
                 Bootstrap (même contournement que le pied de page boxed). -->
            <div style="margin-top:15px; margin-bottom:15px; overflow:hidden;">
                <div style="float:left; width:25%;">
                    <strong>Order date: (jj/mm/aaaa)</strong>
                    <br/>
                    <span t-field="o.date_order" t-options-widget="&quot;date&quot;"/>
                </div>
                <div style="float:left; width:25%;">
                    <strong>Date availibilty reqested: (jj/mm/aaaa)</strong>
                    <br/>
                    <span t-field="o.ca_diff_date_prvue_initiale"/>
                </div>
                <div style="float:left; width:25%;">
                    <strong>Delivery date: (jj/mm/aaaa)</strong>
                    <br/>
                    <span t-field="o.date_planned" t-options-widget="&quot;date&quot;"/>
                </div>
                <div style="float:left; width:25%;">
                    <strong>Forwarder:</strong>
                    <br/>
                    <span t-field="o.ca_diff_transitaire"/>
                </div>
            </div>

            <table class="table table-sm" t-att-style="cad_border + ' color: #495057;'">
                <thead>
                    <tr>
                        <th t-att-style="cad_th_style"><strong>Description</strong></th>
                        <!-- Carton / Unit Carton : en v15, product_packaging_qty /
                             product_packaging_id ; en v19, dérivés de l'UDM carton
                             du produit via les helpers de cadiffusion_base -->
                        <th class="text-right" t-att-style="cad_th_style"><strong>Carton</strong></th>
                        <th class="text-right" t-att-style="cad_th_style"><strong>Unit Carton</strong></th>
                        <th class="text-right" t-att-style="cad_th_style"><strong>QTÉ</strong></th>
                        <th class="text-right" t-att-style="cad_th_style"><strong>PRIX UNITAIRE</strong></th>
                        <th class="text-right" t-att-style="cad_th_style"><strong>MONTANT</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.order_line" t-as="line">
                        <td t-att-style="cad_border">
                            <span t-field="line.name"/>
                        </td>
                        <td class="text-right" t-att-style="cad_border">
                            <span t-esc="line._cadiffusion_carton_qty_display()"/>
                        </td>
                        <td class="text-right" t-att-style="cad_border">
                            <span t-esc="line._cadiffusion_carton_label()"/>
                        </td>
                        <td class="text-right" t-att-style="cad_border">
                            <span t-field="line.product_qty"/>
                            <span t-field="line.product_uom_id"/>
                        </td>
                        <td class="text-right" t-att-style="cad_border">
                            <span t-field="line.price_unit"/>
                        </td>
                        <td class="text-right" t-att-style="cad_border + ' background-color: #e9ecef;'">
                            <span t-field="line.price_subtotal"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Totaux à droite en float : justify-content-end (flex) n'est
                 pas rendu par wkhtmltopdf -->
            <div style="overflow:hidden;">
                <div style="float:right; width:33%;">
                    <table class="table table-sm" t-att-style="cad_border">
                        <tr class="border-black">
                            <td t-att-style="cad_border"><strong>Sous-total</strong></td>
                            <td class="text-right" t-att-style="cad_border + ' background-color: #e9ecef;'">
                                <span t-field="o.amount_untaxed"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td t-att-style="cad_border">Taxes</td>
                            <td class="text-right" t-att-style="cad_border + ' background-color: #e9ecef;'">
                                <span t-field="o.amount_tax"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-black">
                            <td t-att-style="cad_border + ' background-color: rgba(0, 0, 0, 0.9); color: white;'"><strong>Total</strong></td>
                            <td class="text-right" t-att-style="cad_border + ' background-color: rgba(0, 0, 0, 0.9); color: white;'">
                                <span t-field="o.amount_total"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Instructions livraison (FR + EN) : en v15 ce bloc était une
                 personnalisation Studio (en base) du rapport PO ; recréé ici
                 en dur avec le texte de la prod (email logistique@ ; tout en
                 gras sauf le second email, comme en prod). -->
            <div class="mt-4" name="cadiffusion_delivery_instructions">
                <p><strong>Merci de respecter les instructions suivantes avant livraison :</strong></p>
                <p><strong>&gt; Prise du RDV par le transporteur exclusivement par email à :</strong></p>
                <p><strong>logistique@cadiffusion.com</strong></p>
                <p><strong>&gt; Bons de livraisons à joindre impérativement à la demande</strong></p>
                <p><strong>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Sans ces conditions, aucun RDV ne pourra être pris.</strong></p>
                <p><strong>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;——————————————————</strong></p>
                <p><strong>Please pay attention to the following instructions before delivery :</strong></p>
                <p><strong>&gt; Appointment booking only by the carrier by email to :</strong></p>
                <p>logistique@cadiffusion.com</p>
                <p><strong>&gt; Delivery notes must be attached to the request.</strong></p>
                <p><strong>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;No appointment scheduled without these conditions.</strong></p>
            </div>
            <p t-field="o.note" class="mt-4"/>
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_purchaseorder">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="report_cadiffusion.report_purchaseorder_document" t-lang="o.partner_id.lang"/>
        </t>
    </t>
</template>
</odoo>
