<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_purchaseorder_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        <t t-set="address">
            <div t-field="o.partner_id"
            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>
        </t>
        <t t-if="o.dest_address_id">
            <t t-set="information_block">
                <strong>Shipping address:</strong>
                <div t-if="o.dest_address_id">
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                </div>

            </t>
        </t>
        <div class="page">
            <div class="oe_structure"/>
            <h2 t-if="o.state != 'cancel'">Order : <span t-field="o.name"/></h2>
            <h2 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h2>
            <div class="row" style="margin-bottom:10px">
		    <div t-if="o.date_order" class="col-3">
                    <strong>Date de la commande:</strong>
		    <br/>
                    <span t-field="o.date_order" t-options-widget="&quot;date&quot;"/>
		    </div>
                <div t-if="o.date_planned" class="col-3">
                    <strong>A livrer le:</strong>
		    <br/>
                    <span t-field="o.date_planned" t-options-widget="&quot;date&quot;"/>
                </div>
            </div>

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th><strong>Description</strong></th>
                        <!-- <th class="text-right"><strong>Carton</strong></th>
                        <th class="text-right"><strong>Unit Carton</strong></th> -->
                        <th class="text-right"><strong>Unité de mesure</strong></th>
                        <th class="text-right"><strong>QTÉ</strong></th>
                        <th class="text-right"><strong>PRIX UNITAIRE</strong></th>
                        <th class="text-right"><strong>MONTANT</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.order_line" t-as="line">
                        <td>
                            <span t-field="line.name"/>
                        </td>
                        <!-- <td class="text-right">
                            <span t-field="line.product_packaging_qty"/>
                        </td>
                        <td class="text-right">
                            <span t-field="line.product_packaging_id.display_name"/>
                        </td> -->
                        <td class="text-right">
                            <span t-field="line.product_uom_id"/>
                        </td>
                        <td class="text-right">
                            <span t-field="line.product_qty"/>
                            <!-- <span t-field="line.product_uom.name" groups="uom.group_uom"/> -->
                        </td>
                        <td class="text-right">
                            <span t-field="line.price_unit"/>
                        </td>
                        <td class="text-right">
                            <span t-field="line.price_subtotal"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="row justify-content-end">
                <div class="col-4">
                    <table class="table table-sm">
                        <tr class="border-black">
                            <td><strong>Sous-total</strong></td>
                            <td class="text-right">
                                <span t-field="o.amount_untaxed"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td>Taxes</td>
                            <td class="text-right">
                                <span t-field="o.amount_tax"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-black">
                            <td><strong>Total</strong></td>
                            <td class="text-right">
                                <span t-field="o.amount_total"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Instructions livraison (FR + EN) : en v15 ce bloc était une
                 personnalisation Studio (en base) du rapport PO ; recréé ici
                 en dur avec le texte de la prod (email logistique@). -->
            <div class="mt-4" name="cadiffusion_delivery_instructions">
                <p>Merci de respecter les instructions suivantes avant livraison :</p>
                <p>&gt; Prise du RDV par le transporteur exclusivement par email à :</p>
                <p>logistique@cadiffusion.com</p>
                <p>&gt; Bons de livraisons à joindre impérativement à la demande</p>
                <p>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Sans ces conditions, aucun RDV ne pourra être pris.</p>
                <p>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;——————————————————</p>
                <p>Please pay attention to the following instructions before delivery :</p>
                <p>&gt; Appointment booking only by the carrier by email to :</p>
                <p>logistique@cadiffusion.com</p>
                <p>&gt; Delivery notes must be attached to the request.</p>
                <p>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;No appointment scheduled without these conditions.</p>
            </div>
            <p t-field="o.note" class="mt-4"/>
            <div class="oe_structure"/>
        </div>
    </t>
</template>

<template id="report_purchaseorder">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="report_cadiffusion.report_purchaseorder_document" t-lang="o.partner_id.lang"/>
        </t>
    </t>
</template>
</odoo>
