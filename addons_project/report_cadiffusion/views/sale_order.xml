<?xml version="1.0" encoding="utf-8"?>

<odoo>
        <record id="view_form_sale_order_line_add_article_cmd" model="ir.ui.view">
            <field name="name">sale.order form add article cmdé</field>
            <field name="priority">200</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
			    <!--so.line list 视图中添加pack信息-->
                <xpath expr="//header/button[@name='payment_action_capture']" position="after">
                    <button name="print_invoice" type="object" string="Print Invoice"
                        invisible="invoice_count==0" groups='sales_team.group_sale_manager'/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list" position="inside">
                    <field name="article_cmd" optional="show"/>
			    </xpath>
                <!-- Masque product_uom_id à sa position originale -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_id']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <!-- Réinsère product_uom_id juste après Quantité, sans restriction de groupe -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                    <field name="product_uom_id"
                           force_save="1"
                           readonly="product_uom_readonly"
                           widget="many2one_uom"
                           options='{"no_open": True, "no_create": True}'
                           optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Supprime "Devis / Commande" du PDF Quote Builder du menu Imprimer -->
        <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
</odoo>
