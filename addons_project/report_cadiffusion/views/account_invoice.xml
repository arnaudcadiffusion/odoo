<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_form_account_invoice_add_article_cmd" model="ir.ui.view">
            <field name="name">account invoice tree view add article cmdé</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="model">account.move</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
			    <!--account_invoice.line tree 视图中添加article cmdé信息-->
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='currency_id']" position="after">
                    <field name="article_cmd"/>
			    </xpath>
            </field>
        </record>
</odoo>
